{
  "name": "hire-juno",
  "version": "0.1.0",
  "description": "Interactive installer that hires Juno — an AI HR colleague — and the AI workforce template she runs, into your own repo.",
  "type": "module",
  "license": "MIT",
  "author": "Sven Ulrich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sevensc/hire-juno.git"
  },
  "homepage": "https://github.com/sevensc/hire-juno#readme",
  "bugs": {
    "url": "https://github.com/sevensc/hire-juno/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "subagents",
    "llm",
    "prompt-engineering",
    "template",
    "scaffolding"
  ],
  "bin": {
    "hire-juno": "./bin/cli.js",
    "hire-juno-chat": "./chat/bin/chat.js"
  },
  "scripts": {
    "test": "node --test",
    "build:chat": "esbuild chat/src/app.js --bundle --outfile=chat/public/app.js --format=iife",
    "prepublishOnly": "npm run build:chat"
  },
  "files": [
    "bin",
    "src",
    "shared",
    "chat/bin",
    "chat/server",
    "chat/public",
    "CONSTITUTION.md",
    "hr",
    "team/juno",
    "team/roster.md",
    ".claude/agents/juno.md",
    ".claude/agents/examiner-security.md",
    ".claude/agents/examiner-expertise.md",
    ".claude/agents/examiner-brand.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@clack/prompts": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "markdown-it": "^15.0.3",
    "pngjs": "^7.0.0",
    "preact": "^10.29.8"
  }
}
